{
  "name": "capball",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke-capball.mjs",
    "online:server": "tsx server/index.ts",
    "online:test": "vitest run tests/phase4-online.test.ts",
    "manus:build-source": "tsc --noEmit && vite build && node scripts/check-size.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/ws": "8.5.14",
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.18.0",
  "dependencies": {
    "matter-js": "0.20.0",
    "tsx": "4.20.6",
    "ws": "8.22.0"
  }
}
